# Frontend URLs are public. Copy to .env.local only for your own Convex project.
CONVEX_DEPLOYMENT=dev:your-development-deployment
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-development-deployment.convex.site
VITE_SITE_URL=http://localhost:5177

# Set the following in the Convex DEVELOPMENT dashboard, never VITE_* or git:
# SITE_URL=http://localhost:5177
# BETTER_AUTH_SECRET=<random 32+ byte secret>
# GOOGLE_CLIENT_ID=<your dedicated web OAuth client>
# GOOGLE_CLIENT_SECRET=<its client secret>
