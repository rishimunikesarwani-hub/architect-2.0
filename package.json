{
  "name": "architect-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node development-tools/sync-diagram.mjs && vite --config development-tools/vite.config.ts --host 127.0.0.1",
    "build": "tsc --project development-tools/tsconfig.json --noEmit && node development-tools/sync-diagram.mjs && vite build --config development-tools/vite.config.ts",
    "preview": "vite preview --config development-tools/vite.config.ts --host 127.0.0.1",
    "backend": "convex dev",
    "test": "vitest run --config development-tools/vitest.config.ts",
    "typecheck:frontend": "tsc --project development-tools/tsconfig.json --noEmit",
    "typecheck:backend": "tsc --project application/backend/tsconfig.json --noEmit",
    "hygiene": "node development-tools/check-hygiene.mjs",
    "check": "npm run hygiene && npm run typecheck:frontend && npm run typecheck:backend && npm test && npm run build",
    "diagrams": "node development-tools/render-production-diagram.mjs && node development-tools/render-diagram.mjs && node development-tools/sync-diagram.mjs",
    "eval": "node development-tools/run-evaluation.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "better-auth": "1.6.33",
    "convex": "1.46.0",
    "fflate": "0.8.3",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "convex-test": "0.0.60",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
